<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Gorse.NET</PackageId>
    <Version>0.5.11-videohub.1</Version>
    <Authors>zhenghaoz</Authors>
    <Company>gorse.io</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>.NET client for the Gorse recommender system (VideoHub fork).</Description>
    <RepositoryUrl>https://github.com/IbrahimHabibeh/Gorse.NET</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RestSharp" Version="114.0.0" />
  </ItemGroup>
</Project>